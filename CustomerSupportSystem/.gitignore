## .NET / Visual Studio .gitignore for CustomerSupportSystem

# Build results
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# User-specific files (per-developer, should not be shared)
*.suo
*.user
*.userosscache
*.sln.docstates
*.csproj.user

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Build artifacts / intermediate files
*.dll
*.exe
*.pdb
*.cache

# ASP.NET Core secrets and environment-specific config
appsettings.Development.json
appsettings.*.json
!appsettings.json
*.env
.env

# Rider / JetBrains
.idea/

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# Publish output
[Pp]ublish/
*.Publish.xml

# Database files (if using local SQLite/LocalDB during dev)
*.mdf
*.ldf
*.db

# Node (in case any frontend is added later)
node_modules/
